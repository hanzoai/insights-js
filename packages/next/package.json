{
  "name": "@hanzo/insights-next",
  "version": "0.4.73",
  "description": "Hanzo Insights integration for Next.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoinsights/insights-js.git",
    "directory": "packages/next"
  },
  "author": {
    "name": "Hanzo AI",
    "email": "dev@hanzo.ai",
    "url": "https://hanzo.ai"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "insights",
    "nextjs",
    "analytics",
    "feature-flags"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "edge-light": "./dist/index.edge.js",
      "edge": "./dist/index.edge.js",
      "worker": "./dist/index.edge.js",
      "browser": "./dist/index.client.js",
      "react-server": "./dist/index.js",
      "default": "./dist/index.client.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "edge-light": "./dist/pages.edge.js",
      "edge": "./dist/pages.edge.js",
      "worker": "./dist/pages.edge.js",
      "browser": "./dist/pages.client.js",
      "react-server": "./dist/pages.js",
      "default": "./dist/pages.client.js"
    }
  },
  "main": "./dist/index.client.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/__tests__"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsgo -p tsconfig.build.json && pnpm check:esm-specifiers",
    "dev": "tsgo -p tsconfig.build.json --watch",
    "check:esm-specifiers": "node ./scripts/check-relative-esm-specifiers.mjs",
    "test:unit": "jest",
    "test": "pnpm test:unit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "pnpm lint && pnpm test:unit && pnpm build",
    "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
  },
  "dependencies": {
    "@hanzo/insights-core": "workspace:*",
    "@hanzo/insights-react": "workspace:*",
    "@hanzo/insights": "workspace:*",
    "@hanzo/insights-node": "workspace:*",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@hanzo/insights-tooling-tsconfig-base": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vercel/functions": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@vercel/functions": ">=3",
    "next": ">=16.3.3",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "@vercel/functions": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.23.0"
}
