{
  "name": "@hanzo/insights-nuxt",
  "version": "1.5.72",
  "description": "Nuxt module for Hanzo Insights.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoinsights/insights-js.git",
    "directory": "packages/nuxt"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "nuxt prepare",
    "build": "nuxt-module-build build",
    "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz",
    "lint": "eslint .",
    "test:unit": "node tests/vue-plugin.test.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@hanzo/insights-node": "workspace:*",
    "@hanzo/insights-core": "workspace:*",
    "@hanzo/insights": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "nuxt": "catalog:",
    "@nuxt/devtools": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/eslint-config": "catalog:",
    "eslint": "catalog:"
  }
}
