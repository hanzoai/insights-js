{
  "name": "react-router",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "pnpm run build-@hanzo/insights && pnpm link-@hanzo/insights && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "build-@hanzo/insights": "cd ../../ && NODE_ENV=dev pnpm i && pnpm run build",
    "link-@hanzo/insights": "pnpm link ../.."
  },
  "dependencies": {
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "isbot": "catalog:",
    "@hanzo/insights": "file:../../dist/",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-router-devtools": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@hanzo/insights": "link:../.."
    }
  }
}
