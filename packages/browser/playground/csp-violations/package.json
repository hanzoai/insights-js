{
  "name": "csp-violations-playground",
  "version": "1.0.0",
  "description": "A playground for testing CSP violation reports with Insights",
  "main": "server.js",
  "scripts": {
    "build": "NODE_ENV=production rollup -c",
    "rollup:watch": "rollup -c -w",
    "serve": "nodemon server.js",
    "dev": "concurrently -k -n \"ROLLUP,SERVE\" -c \"magenta,cyan\" \"npm:rollup:watch\" \"npm:serve\"",
    "start": "node server.js"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-replace": "catalog:",
    "concurrently": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "@hanzo/insights": "file:../..",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "nodemon": "catalog:"
  }
}
