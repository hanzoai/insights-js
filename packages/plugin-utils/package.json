{
  "name": "@hanzo/insights-plugin-utils",
  "version": "1.1.1",
  "description": "Shared CLI and sourcemap utilities for Hanzo Insights build plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoinsights/insights-js.git",
    "directory": "packages/plugin-utils"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__/**",
    "!src/**/*.spec.ts"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "rslib build",
    "dev": "rslib build -w",
    "test:unit": "jest",
    "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
  },
  "dependencies": {
    "cross-spawn": "catalog:"
  },
  "devDependencies": {
    "@hanzo/insights-tooling-tsconfig-base": "workspace:*",
    "@rslib/core": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:"
  }
}
