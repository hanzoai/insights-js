{
  "extends": "@hanzo/insights-tooling-tsconfig-base",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    "module": "node16",
    "moduleResolution": "node16",
    "isolatedModules": true,
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "target": "ES2022",
    "lib": ["ES2022"]
  },
  "include": ["src/**/*"]
}
