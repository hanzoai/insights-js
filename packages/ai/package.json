{
  "name": "@hanzo/insights-ai",
  "version": "7.9.4",
  "description": "Hanzo Insights AI integrations for LLM observability.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoinsights/insights-js.git",
    "directory": "packages/ai"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "test:unit": "jest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "prepublishOnly": "pnpm lint && pnpm test:unit && pnpm build",
    "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
  },
  "devDependencies": {
    "@ai-sdk/provider": "catalog:",
    "@openai/agents": "catalog:",
    "@openai/agents-core": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/otlp-exporter-base": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@hanzo/insights-tooling-rollup-utils": "workspace:*",
    "@hanzo/insights-tooling-tsconfig-base": "workspace:*",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "node-fetch": "catalog:",
    "@hanzo/insights-node": "workspace:*"
  },
  "keywords": [
    "hanzo",
    "insights",
    "ai",
    "openai",
    "anthropic",
    "gemini",
    "llm",
    "observability",
    "agents"
  ],
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@google/genai": "catalog:",
    "@langchain/core": "catalog:",
    "@hanzo/insights-core": "workspace:*",
    "langchain": "catalog:",
    "openai": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1",
    "@opentelemetry/exporter-trace-otlp-http": ">=0",
    "@opentelemetry/sdk-trace-base": ">=2",
    "@ai-sdk/provider": ">=4",
    "@hanzo/insights-node": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@ai-sdk/provider": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./anthropic": {
      "require": "./dist/anthropic/index.cjs",
      "import": "./dist/anthropic/index.mjs",
      "types": "./dist/anthropic/index.d.ts"
    },
    "./gemini": {
      "require": "./dist/gemini/index.cjs",
      "import": "./dist/gemini/index.mjs",
      "types": "./dist/gemini/index.d.ts"
    },
    "./openai": {
      "require": "./dist/openai/index.cjs",
      "import": "./dist/openai/index.mjs",
      "types": "./dist/openai/index.d.ts"
    },
    "./vercel": {
      "require": "./dist/vercel/index.cjs",
      "import": "./dist/vercel/index.mjs",
      "types": "./dist/vercel/index.d.ts"
    },
    "./otel": {
      "require": "./dist/otel/index.cjs",
      "import": "./dist/otel/index.mjs",
      "types": "./dist/otel/index.d.ts"
    },
    "./langchain": {
      "require": "./dist/langchain/index.cjs",
      "import": "./dist/langchain/index.mjs",
      "types": "./dist/langchain/index.d.ts"
    },
    "./openai-agents": {
      "require": "./dist/openai-agents/index.cjs",
      "import": "./dist/openai-agents/index.mjs",
      "types": "./dist/openai-agents/index.d.ts"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "author": {
    "name": "Hanzo AI",
    "email": "dev@hanzo.ai",
    "url": "https://hanzo.ai"
  },
  "bugs": {
    "url": "https://github.com/hanzoinsights/insights-js/issues"
  },
  "homepage": "https://docs.hanzo.ai/insights/ai"
}
