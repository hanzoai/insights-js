{
  "name": "@hanzo/insights-react-native",
  "version": "4.37.1",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metro": {
      "types": "./dist/tooling/metroconfig.d.ts",
      "default": "./dist/tooling/metroconfig.js"
    },
    "./expo": {
      "types": "./dist/tooling/expoconfig.d.ts",
      "default": "./dist/tooling/expoconfig.js"
    }
  },
  "files": [
    "dist/",
    "tooling/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoinsights/insights-js.git",
    "directory": "packages/react-native"
  },
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test:unit": "jest -c jest.config.js",
    "test": "pnpm test:unit",
    "prepublishOnly": "pnpm lint && pnpm test:unit && pnpm build",
    "prebuild": "node -p \"'export const version = ' + JSON.stringify(require('./package.json').version)\" > src/version.ts",
    "build": "tsc -b && babel ./dist --out-dir dist --extensions '.js'",
    "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz",
    "generate-references": "pnpm exec api-extractor run --config ./api-extractor.json --local && node scripts/generate-docs.js"
  },
  "dependencies": {
    "@hanzo/insights-core": "workspace:*"
  },
  "devDependencies": {
    "@babel/cli": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@babel/plugin-transform-class-properties": "catalog:",
    "@babel/plugin-transform-private-methods": "catalog:",
    "@babel/plugin-transform-private-property-in-object": "catalog:",
    "@hanzo/insights-tooling-rollup-utils": "workspace:*",
    "@hanzo/insights-tooling-tsconfig-base": "workspace:*",
    "@react-native-async-storage/async-storage": "catalog:",
    "@react-native/babel-preset": "catalog:",
    "@react-navigation/native": "catalog:",
    "@types/react": "catalog:",
    "@types/react-native": "catalog:",
    "@types/jest": "catalog:",
    "expo": "catalog:",
    "expo-application": "catalog:",
    "expo-device": "catalog:",
    "expo-file-system": "catalog:",
    "expo-localization": "catalog:",
    "@testing-library/react": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "jest-environment-node": "catalog:",
    "jest-expo": "catalog:",
    "metro": "catalog:",
    "@expo/metro-config": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-device-info": "catalog:",
    "react-native-localize": "catalog:",
    "react-native-navigation": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=3",
    "@react-navigation/native": ">=7",
    "expo-application": ">=57",
    "expo-device": ">=57",
    "expo-file-system": ">=57",
    "expo-localization": ">=57",
    "@hanzo/insights-react-native-session-replay": ">= 1.5.0",
    "react-native-device-info": ">=15",
    "react-native-localize": ">=3",
    "react-native-navigation": ">=8",
    "react-native-safe-area-context": ">=5",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-navigation/native": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-localization": {
      "optional": true
    },
    "react-native-device-info": {
      "optional": true
    },
    "react-native-navigation": {
      "optional": true
    },
    "react-native-localize": {
      "optional": true
    },
    "@hanzo/insights-react-native-session-replay": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  }
}
