{
  "name": "@hanzo/rrdom",
  "version": "0.0.65",
  "license": "MIT",
  "type": "module",
  "main": "./dist/rrdom.cjs",
  "module": "./dist/rrdom.js",
  "unpkg": "./dist/rrdom.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/rrdom.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/rrdom.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoinsights/insights-js.git"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm turbo run prepublish",
    "check-types": "tsc -noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublish": "tsc -noEmit && vite build",
    "lint": "pnpm eslint src/**/*.ts"
  },
  "devDependencies": {
    "@hanzo/rrweb-types": "workspace:*",
    "@types/jsdom": "catalog:",
    "jsdom": "catalog:",
    "puppeteer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@hanzo/rrweb-snapshot": "workspace:*"
  }
}
