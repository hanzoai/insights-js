{
  "name": "rrdom-nodejs",
  "version": "0.0.4",
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm turbo run prepublish",
    "check-types": "tsc -noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepublish": "tsc -noEmit && vite build",
    "lint": "pnpm eslint src/**/*.ts"
  },
  "keywords": [
    "rrweb",
    "rrdom-nodejs"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/rrdom-nodejs.umd.cjs",
  "module": "./dist/rrdom-nodejs.js",
  "unpkg": "./dist/rrdom-nodejs.umd.cjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/rrdom-nodejs.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/rrdom-nodejs.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/cssom": "catalog:",
    "@types/cssstyle": "catalog:",
    "@types/nwsapi": "catalog:",
    "compare-versions": "catalog:",
    "puppeteer": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "cssom": "catalog:",
    "cssstyle": "catalog:",
    "nwsapi": "catalog:",
    "@hanzo/rrdom": "workspace:*",
    "@hanzo/rrweb-types": "workspace:*"
  }
}
