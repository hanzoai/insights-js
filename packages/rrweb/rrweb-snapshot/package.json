{
  "name": "@hanzo/rrweb-snapshot",
  "version": "0.0.65",
  "description": "rrweb's component to take a snapshot of DOM, aka DOM serializer",
  "scripts": {
    "retest": "vitest run",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "retest:update": "vitest run --update",
    "test:update": "vitest run --update",
    "bench": "vite build && vitest bench",
    "dev": "vite build --watch",
    "build": "pnpm turbo run prepublish",
    "check-types": "tsc --noEmit",
    "prepublish": "pnpm check-types && vite build",
    "lint": "pnpm eslint src"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoinsights/insights-js.git"
  },
  "main": "./dist/rrweb-snapshot.cjs",
  "module": "./dist/rrweb-snapshot.js",
  "unpkg": "./dist/rrweb-snapshot.umd.cjs",
  "typings": "dist/rrweb-snapshot.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/rrweb-snapshot.d.ts",
        "default": "./dist/rrweb-snapshot.js"
      },
      "require": {
        "types": "./dist/rrweb-snapshot.d.cts",
        "default": "./dist/rrweb-snapshot.cjs"
      }
    },
    "./record": {
      "import": {
        "types": "./dist/record.d.ts",
        "default": "./dist/record.js"
      },
      "require": {
        "types": "./dist/record.d.cts",
        "default": "./dist/record.cjs"
      }
    },
    "./replay": {
      "import": {
        "types": "./dist/replay.d.ts",
        "default": "./dist/replay.js"
      },
      "require": {
        "types": "./dist/replay.d.cts",
        "default": "./dist/replay.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "author": "yanzhen@smartx.com",
  "license": "MIT",
  "devDependencies": {
    "@hanzo/rrweb-types": "workspace:*",
    "@hanzo/rrweb-utils": "workspace:*",
    "@types/jsdom": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "@types/node": "catalog:",
    "puppeteer": "catalog:",
    "ts-node": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@types/postcss-safe-parser": "catalog:",
    "postcss": "catalog:",
    "postcss-safe-parser": "catalog:"
  }
}
