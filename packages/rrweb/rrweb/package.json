{
  "name": "@hanzo/rrweb",
  "version": "0.0.67",
  "description": "record and replay the web",
  "scripts": {
    "retest": "cross-env PUPPETEER_HEADLESS=true pnpm retest:headful",
    "retest:headful": "vitest run --exclude test/benchmark",
    "build-and-test": "pnpm build && pnpm retest",
    "test:headless": "cross-env PUPPETEER_HEADLESS=true pnpm build-and-test",
    "test:headful": "cross-env PUPPETEER_HEADLESS=false pnpm build-and-test",
    "test": "pnpm test:headless",
    "test:watch": "pnpm build && cross-env PUPPETEER_HEADLESS=true pnpm vitest --exclude test/benchmark",
    "test:update": "pnpm test:headless --update",
    "retest:update": "cross-env PUPPETEER_HEADLESS=true pnpm retest --update",
    "dev": "vite build --watch",
    "build": "pnpm turbo run prepublish",
    "check-types": "tsc -noEmit",
    "prepublish": "tsc -noEmit && vite build",
    "lint": "pnpm eslint src"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoinsights/insights-js"
  },
  "main": "./dist/rrweb.umd.cjs",
  "module": "./dist/rrweb.js",
  "unpkg": "./dist/rrweb.umd.cjs",
  "typings": "dist/rrweb.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/rrweb.d.ts",
        "default": "./dist/rrweb.js"
      },
      "require": {
        "types": "./dist/rrweb.d.cts",
        "default": "./dist/rrweb.cjs"
      }
    },
    "./dist/rrweb.css": "./dist/rrweb.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "sideEffects": false,
  "author": "yanzhen@smartx.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hanzoinsights/insights-js/issues"
  },
  "homepage": "https://github.com/hanzoinsights/insights-js#readme",
  "devDependencies": {
    "@types/dom-mediacapture-transform": "catalog:",
    "@types/jest-image-snapshot": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/offscreencanvas": "catalog:",
    "cross-env": "catalog:",
    "jsdom": "catalog:",
    "construct-style-sheets-polyfill": "catalog:",
    "fast-mhtml": "catalog:",
    "identity-obj-proxy": "catalog:",
    "ignore-styles": "catalog:",
    "jest-image-snapshot": "catalog:",
    "puppeteer": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@hanzo/rrweb-types": "workspace:*",
    "@hanzo/rrweb-utils": "workspace:*",
    "@types/css-font-loading-module": "catalog:",
    "@xstate/fsm": "catalog:",
    "base64-arraybuffer": "catalog:",
    "mitt": "catalog:",
    "@hanzo/rrdom": "workspace:*",
    "@hanzo/rrweb-snapshot": "workspace:*"
  }
}
