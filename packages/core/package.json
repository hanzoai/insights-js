{
  "name": "@hanzo/insights-core",
  "version": "1.23.2",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "error-tracking": [
        "dist/error-tracking/index.d.ts"
      ],
      "surveys": [
        "dist/surveys/index.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ],
      "utils": [
        "dist/utils/index.d.ts"
      ],
      "process": [
        "dist/process/index.d.ts"
      ],
      "vendor/*": [
        "dist/vendor/*.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoinsights/insights-js.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "rslib build",
    "dev": "rslib build -w",
    "test:unit": "jest",
    "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./error-tracking": {
      "types": "./dist/error-tracking/index.d.ts",
      "require": "./dist/error-tracking/index.js",
      "import": "./dist/error-tracking/index.mjs"
    },
    "./vendor/*": {
      "types": "./dist/vendor/*.d.ts",
      "require": "./dist/vendor/*.js",
      "import": "./dist/vendor/*.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "require": "./dist/testing/index.js",
      "import": "./dist/testing/index.mjs"
    },
    "./surveys": {
      "types": "./dist/surveys/index.d.ts",
      "require": "./dist/surveys/index.js",
      "import": "./dist/surveys/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.js",
      "import": "./dist/utils/index.mjs"
    },
    "./process": {
      "types": "./dist/process/index.d.ts",
      "require": "./dist/process/index.js",
      "import": "./dist/process/index.mjs"
    }
  },
  "dependencies": {
    "@hanzo/insights-types": "workspace:*",
    "cross-spawn": "catalog:"
  },
  "devDependencies": {
    "@hanzo/insights-tooling-tsconfig-base": "workspace:*",
    "@rslib/core": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:"
  }
}
