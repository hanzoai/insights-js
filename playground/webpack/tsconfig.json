{
    "compilerOptions": {
        "incremental": false,
        "rootDir": ".",
        "target": "ES6",
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "lib": [
          "DOM"
        ],
        "paths": {
          "*": [
            "./src/*"
          ]
        }
    }
}
