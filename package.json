{
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build-rollup": "pnpm --filter=@hanzo/insights build-rollup",
    "clean": "turbo clean",
    "clean:dep": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:playground": "prettier --check 'playground/**/*.{ts,tsx,js,jsx,mjs,json,md}' && eslint 'playground/**/*.{ts,tsx,js,jsx,mjs}'",
    "lint:playground:fix": "prettier --write 'playground/**/*.{ts,tsx,js,jsx,mjs,json,md}' && eslint --fix 'playground/**/*.{ts,tsx,js,jsx,mjs}'",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:functional": "turbo test:functional",
    "test:e2e": "turbo test:e2e",
    "build": "turbo build",
    "dev": "turbo dev",
    "package": "export PACKAGE_DEST=$(pwd)/target && turbo package",
    "package:watch": "export PACKAGE_DEST=$(pwd)/target && turbo watch package",
    "bump": "pnpm changeset version",
    "generate-references": "pnpm turbo --filter=@hanzo/insights --filter=@hanzo/insights-node --filter=@hanzo/insights-react-native generate-references"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@microsoft/api-extractor-model": "catalog:",
    "@microsoft/tsdoc": "catalog:",
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "esbuild-plugin-umd-wrapper": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-@hanzo/insights": "link:tooling/eslint-plugin-insights",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-compat": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-no-only-tests": "catalog:",
    "eslint-plugin-insights": "link:tooling/eslint-plugin-insights",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "ts-node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  }
}
